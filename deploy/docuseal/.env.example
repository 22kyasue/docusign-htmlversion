# DocuSeal deploy — Tobira Studio
# Copy to .env and fill before `docker compose up -d`.  Do NOT commit the real .env.

# Public domain DocuSeal answers on. Must have an A record → this box's public IP.
HOST=sign.tobirastudio.com

# Postgres password. Generate a strong one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- SMTP (optional) -------------------------------------------------------
# Easiest path: leave these blank and set SMTP in DocuSeal Settings → Email
# after first boot. To wire it via env instead, fill these AND uncomment the
# matching SMTP_* lines in docker-compose.yml, then re-run `docker compose up -d`.
# SMTP_ADDRESS=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=contracts@tobirastudio.com
# SMTP_AUTHENTICATION=plain
# SMTP_SECURITY=tls

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sovereign-sign runtime data (your PDFs, audit log)
/data/
# encrypted backups produced by scripts/backup-data.mjs
/backups/
# local dev/test scratch output (server logs, e2e fixtures, screenshots)
/devserver.out
/receiver.out
/webhook-received.log
/e2e-*.json
/e2e-*.png

# pdfjs worker is copied by postinstall — no need to commit
/public/pdf.worker.min.mjs
